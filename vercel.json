{
  "framework": "nextjs",
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/brand/nk-mark.svg"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/share/:type/:id",
      "destination": "/api/og?type=:type&id=:id"
    }
  ]
}
