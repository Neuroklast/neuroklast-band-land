# ─── Band Land — Environment Variables ───────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# For Vercel deployments, set these in your project's Environment Variables UI.
#
# Required for admin features and data persistence:
ADMIN_SETUP_TOKEN=          # One-time token to create the first admin password
KV_REST_API_URL=            # Upstash Redis REST API URL (from Vercel KV or Upstash dashboard)
KV_REST_API_TOKEN=          # Upstash Redis REST API token

# Optional — needed for contact form email forwarding:
RESEND_API_KEY=             # Resend API key (https://resend.com)
