# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres URI (port 5432, not the pooler) — schema apply on deploy
SUPABASE_DB_URL=postgresql://postgres.xxxx:password@db.xxxx.supabase.co:5432/postgres

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_MEDIA=neuroklast-media
R2_PUBLIC_HOST=https://pub-xxxx.r2.dev

# App
NEXT_PUBLIC_SITE_URL=https://neuroklast.net
SITE_URL=https://neuroklast.net

# Contact (Resend) — no inbox; mail only
CONTACT_EMAIL=booking@neuroklast.net
CONTACT_FROM_EMAIL=Neuroklast Website <noreply@neuroklast.net>
RESEND_API_KEY=re_...

# AES-256-GCM master key for encrypted API secrets in Supabase (64 hex chars / 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# Salt for hashing client IPs before storage (Supabase rate limiter). REQUIRED in production.
RATE_LIMIT_SALT=

# Optional: migrate existing Vite/KV band config + Google Drive files
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# GOOGLE_DRIVE_API_KEY=

# Dev Mode (set to true to use mock/demo data instead of Supabase)
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_HIDE_DEMO_FALLBACK=false
NEXT_PUBLIC_SHOW_DEMO_BADGE=false

# NEUROKLAST plugin licensing / commerce (all server-only; never NEXT_PUBLIC)
# Plugins are managed in Admin -> Plugins (product page, versions, licences, keys).
# Free plugins need no licence and no Stripe price.
# Keep Stripe sales disabled until docs/NEUROKORE_COMMERCE.md launch checks pass.
NEUROKORE_SITE_URL=https://neuroklast.net
NEUROKORE_SALES_ENABLED=false
# Required before starting any paid software checkout. Set ONLY after confirming
# the seller's actual VAT regime. Neither Stripe account country nor revenue
# estimates are proof. Values: small_business | vat_registered
# small_business: Stripe Auto Tax disabled, invoice footer cites §19 UStG.
# vat_registered: Stripe Auto Tax enabled and requires active tax registrations.
NEUROKORE_TAX_MODE=
NEUROKORE_SIGNING_PRIVATE_KEY=
NEUROKORE_KEY_ENCRYPTION_SECRET=
# Downloads resolve published builds from the database and R2 (Admin -> Plugins -> Versions).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-product Stripe price IDs are stored in Admin -> Plugins, not in env.

# Server-only shared credential for Release Manager -> R2 + Products version import (64 hex).
NEUROKORE_RELEASE_SYNC_TOKEN=
