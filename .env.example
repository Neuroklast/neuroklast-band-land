# ─── Band Land — Environment Variables ───────────────────────────────────────
#
# Copy this file to .env and fill in the values for local development.
# For production, set these in your platform's environment variables UI:
#   Vercel  → Settings → Environment Variables
#   Netlify → Site settings → Environment variables
#   Railway → Variables tab
#   Render  → Environment tab
#   Docker  → pass as --build-arg (for NEXT_PUBLIC_* vars) or -e (for runtime vars)
#
# ─── Required: Admin & Data Persistence ──────────────────────────────────────
ADMIN_SETUP_TOKEN=          # One-time token to create the first admin password
KV_REST_API_URL=            # Upstash Redis REST API URL (from Vercel KV or Upstash dashboard)
KV_REST_API_TOKEN=          # Upstash Redis REST API token

# ─── Required: Deployment Activation ─────────────────────────────────────────
NEXT_PUBLIC_ACTIVATION_KEY=        # Activation key issued by Neuroklast (optional; unset defaults to free tier)
# NEXT_PUBLIC_ACTIVATION_API_URL=  # Optional: override the activation API URL (e.g. for local testing)
NEXT_PUBLIC_PRIMARY_HOSTNAMES=     # Optional: comma-separated hostnames treated as primary instance


# ─── Required: Security ───────────────────────────────────────────────────────
ALLOWED_ORIGIN=             # Full origin of your deployment, e.g. https://yourdomain.com
                            # REQUIRED in production — API endpoints hard-fail without this.
                            # Prevents cross-origin forgery on POST/DELETE endpoints.
RATE_LIMIT_SALT=            # Random secret string for IP-hash salt (required in production).
                            # Generate with: openssl rand -hex 32

# Optional — needed for contact form email forwarding:
RESEND_API_KEY=             # Resend API key (https://resend.com)
CONTACT_FROM_EMAIL=         # Sender address, e.g. "Neuroklast Website <noreply@neuroklast.de>"
CONTACT_TO_EMAIL=           # Recipient address for incoming contact messages, e.g. booking@neuroklast.de


# ─── Required: Site Identity ──────────────────────────────────────────────────
SITE_NAME=                  # Your band/artist name, used in email subjects and alerts
SITE_URL=                   # Full URL of your deployment, e.g. https://yourdomain.com
SITE_DESCRIPTION=           # Short description of your site for email templates

# ─── Optional: Email Notifications ───────────────────────────────────────────
# Contact form and newsletter — choose Brevo OR Resend (not both).
# Brevo (https://brevo.com — recommended, generous free tier):
BREVO_API_KEY=              # Brevo transactional email API key
BREVO_LIST_ID=              # Brevo contact list ID (for newsletter subscriptions)
CONTACT_EMAIL_TO=           # Email address to receive contact form submissions (used by Brevo)
EMAIL_FROM=                 # Sender email address for outgoing notifications
# Resend (https://resend.com — alternative):
RESEND_API_KEY=             # Resend API key

# ─── Optional: Newsletter (Mailchimp alternative) ─────────────────────────────
MAILCHIMP_API_KEY=          # Mailchimp API key (if using Mailchimp instead of Brevo)
MAILCHIMP_LIST_ID=          # Mailchimp audience/list ID

# ─── Optional: Alerting & Monitoring ─────────────────────────────────────────
DISCORD_WEBHOOK_URL=        # Discord webhook for security/IDS alerts
ADMIN_RESET_EMAIL=          # Email address allowed to receive admin password-reset tokens

# ─── Optional: OAuth / Google Drive ──────────────────────────────────────────
GOOGLE_CLIENT_ID=           # Google OAuth client ID (for Drive integration)
GOOGLE_CLIENT_SECRET=       # Google OAuth client secret
GOOGLE_DRIVE_API_KEY=       # Google Drive API key (for read-only Drive folder access)
OAUTH_APP_URL=              # Base URL used for OAuth redirect URIs
OAUTH_ENCRYPTION_KEY=       # 32-byte hex key for encrypting OAuth tokens at rest
                            # Generate with: openssl rand -hex 32

# ─── Optional: Spotify Integration ───────────────────────────────────────────
SPOTIFY_CLIENT_ID=          # Spotify API client ID (for Spotify widget/search)
SPOTIFY_CLIENT_SECRET=      # Spotify API client secret

# ─── Optional: Third-party Widgets ───────────────────────────────────────────
# Get your free API key at https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=          # Setlist.fm API key (for gig history widget)
